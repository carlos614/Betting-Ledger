PORT=3000
# Postgres publicado pelo Docker Compose na porta 5433 do host
DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566

SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events

# PENDING_REFERENCE: 8 tentativas, backoff 5s·2^n (teto 300s) e TTL de 30 min
PENDING_MAX_ATTEMPTS=8
PENDING_BASE_DELAY_SECONDS=5
PENDING_TTL_SECONDS=1800
LOCK_TIMEOUT_MS=10000
